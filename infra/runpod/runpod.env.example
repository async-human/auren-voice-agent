# Secrets: store these in RunPod Secrets, not directly in a template or file.
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
TOOL_GATEWAY_TOKEN=replace_me
# Needs Pod stop permission. RUNPOD_POD_ID is injected by RunPod.
RUNPOD_API_KEY=replace_me

# Non-secret production configuration.
LIVEKIT_URL=wss://your-production-project.livekit.cloud
TOOL_GATEWAY_BASE_URL=https://your-railway-api.up.railway.app
LIVEKIT_AGENT_NAME=auren-agent
AUREN_ENV=production
ASSISTANT_NAME=Auren
ASSISTANT_FORM_OF_ADDRESS=
ASSISTANT_LANGUAGE=match-user
AGENT_SKILLS=client_followup
# Whisper is the safe default. Add companion endpoints before enabling their
# names here; each LiveKit session can then choose its own provider.
STT_PROVIDER=whisper
STT_AVAILABLE_PROVIDERS=whisper
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_MODEL=Systran/faster-whisper-medium.en
STT_LANGUAGE=en
STT_USE_REALTIME=false
STT_API_KEY=local
# Optional when the provider uses a non-standard health route.
# STT_HEALTH_URL=http://127.0.0.1:8000/health

# Qwen3-ASR companion endpoint:
# QWEN_ASR_BASE_URL=http://qwen-asr.internal:8011/v1
# QWEN_ASR_HEALTH_URL=http://qwen-asr.internal:8011/health
# QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# QWEN_ASR_LANGUAGE=
# QWEN_ASR_USE_REALTIME=false
# QWEN_ASR_API_KEY={{ RUNPOD_SECRET_qwen_stt_api_key }}

# Enable the selector after the Qwen companion service is reachable:
# STT_AVAILABLE_PROVIDERS=whisper,qwen

# For Whisper, medium.en is the latency default; use large-v3 only with headroom.
# STT_MODEL=Systran/faster-whisper-large-v3
LLM_MODEL=qwen3:8b
# Qwen3 thinking mode can add tens of seconds (or minutes) before any reply.
LLM_DISABLE_THINKING=true
LLM_MAX_COMPLETION_TOKENS=220
CHATTERBOX_MODEL=chatterbox-turbo
CHATTERBOX_VOICE=Olivia.wav
CHATTERBOX_TIMEOUT_SECONDS=30
CHATTERBOX_MAX_SEGMENT_CHARS=120
CHATTERBOX_RETRY_ATTEMPTS=1
AUREN_AUDIO_SMOKE_TIMEOUT_SECONDS=180
TTS_BF16=auto
STT_PRELOAD=true
VISION_PRELOAD=false

# Idle shutdown. The Pod stops only when there are no live LiveKit sessions,
# model bootstrap has finished, and average GPU stays under the threshold for
# the whole idle window. Storage is still billed while the Pod is stopped.
AUTO_STOP_ENABLED=true
AUTO_STOP_IDLE_MINUTES=30
AUTO_STOP_GPU_THRESHOLD=5
AUTO_STOP_STARTUP_GRACE_MINUTES=20

# Use only once when migrating root-owned files from an older pod.
AUREN_FIX_VOLUME_PERMISSIONS=false
