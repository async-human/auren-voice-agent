# Secrets: store these in RunPod Secrets, not directly in a template or file.
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Non-secret production configuration.
LIVEKIT_URL=wss://your-production-project.livekit.cloud
LIVEKIT_AGENT_NAME=auren-agent
AUREN_ENV=production
FASTER_WHISPER_MODEL=Systran/faster-whisper-large-v3
LLM_MODEL=qwen3:8b
CHATTERBOX_MODEL=chatterbox-turbo
CHATTERBOX_VOICE=Olivia.wav
TTS_BF16=auto
STT_PRELOAD=true

# Use only once when migrating root-owned files from an older pod.
AUREN_FIX_VOLUME_PERMISSIONS=false
