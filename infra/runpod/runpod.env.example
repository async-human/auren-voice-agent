# Secrets: store these in RunPod Secrets, not directly in a template or file.
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
TOOL_GATEWAY_TOKEN=replace_me
# Needs Pod stop permission. RUNPOD_POD_ID is injected by RunPod.
RUNPOD_API_KEY=replace_me

# Non-secret production configuration.
LIVEKIT_URL=wss://your-production-project.livekit.cloud
TOOL_GATEWAY_BASE_URL=https://your-railway-api.up.railway.app
LIVEKIT_AGENT_NAME=auren-agent
AUREN_ENV=production
FASTER_WHISPER_MODEL=Systran/faster-whisper-large-v3
LLM_MODEL=qwen3:8b
CHATTERBOX_MODEL=chatterbox-turbo
CHATTERBOX_VOICE=Olivia.wav
CHATTERBOX_TIMEOUT_SECONDS=90
CHATTERBOX_MAX_SEGMENT_CHARS=180
CHATTERBOX_RETRY_ATTEMPTS=2
AUREN_AUDIO_SMOKE_TIMEOUT_SECONDS=180
TTS_BF16=auto
STT_PRELOAD=true

# Idle shutdown. The Pod stops only when there are no live LiveKit sessions,
# model bootstrap has finished, and average GPU stays under the threshold for
# the whole idle window. Storage is still billed while the Pod is stopped.
AUTO_STOP_ENABLED=true
AUTO_STOP_IDLE_MINUTES=30
AUTO_STOP_GPU_THRESHOLD=5
AUTO_STOP_STARTUP_GRACE_MINUTES=20

# Use only once when migrating root-owned files from an older pod.
AUREN_FIX_VOLUME_PERMISSIONS=false
