# Store this value in RunPod Secrets. Do not paste it directly into a template.
QWEN_ASR_API_KEY={{ RUNPOD_SECRET_qwen_stt_api_key }}

# Non-secret runtime configuration for an RTX A5000 24 GB companion pod.
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_PORT=8011
QWEN_ASR_GPU_MEMORY_UTILIZATION=0.55
QWEN_ASR_MAX_MODEL_LEN=4096
QWEN_ASR_MAX_NUM_SEQS=8
QWEN_ASR_ENFORCE_EAGER=true

# Model downloads persist here through the /workspace network volume.
HF_HOME=/workspace/models/qwen/huggingface
HF_HUB_CACHE=/workspace/models/qwen/huggingface/hub
HF_HUB_ENABLE_HF_TRANSFER=0
