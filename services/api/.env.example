AUREN_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000

# Use a token-service-specific LiveKit key pair.
LIVEKIT_URL=wss://your-development-project.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
LIVEKIT_AGENT_NAME=auren-agent

# SQLite keeps local development dependency-free. Railway/Neon/Supabase
# Postgres URLs are accepted as-is and rewritten to use asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./auren.db

# Clerk. The API verifies browser session tokens offline against this issuer's
# JWKS, so no Clerk secret key is needed here. Required in production.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=  # only if the issuer does not serve /.well-known/jwks.json

# Offline escape hatch: acts as a fixed signed-in user when CLERK_ISSUER is
# unset. Ignored entirely when AUREN_ENV=production.
# DEV_USER_ID=local-developer

# Shared secret the voice worker sends as X-Auren-Service-Token.
# Required when AUREN_ENV=production.
TOOL_GATEWAY_TOKEN=replace_me

# Timezone assumed when the user does not name one.
DEFAULT_TIMEZONE=Asia/Kolkata

# Web search. Weather needs no key (Open-Meteo).
# auto picks the first configured provider, else a keyless DuckDuckGo fallback.
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=

# Google Calendar + Gmail (OAuth tokens encrypted at rest on the API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/connections/google/callback
PUBLIC_APP_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=replace_with_long_random_string
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
