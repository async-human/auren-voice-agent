## Runtime
AUREN_ENV=development

## LiveKit worker credentials (use a worker-specific key pair)
LIVEKIT_URL=wss://your-development-project.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
LIVEKIT_AGENT_NAME=auren-agent

## Railway tool gateway. Leave the URL blank to run without tools.
TOOL_GATEWAY_BASE_URL=http://localhost:8080
TOOL_GATEWAY_TOKEN=replace_me
TOOL_GATEWAY_TIMEOUT_SECONDS=20

## Speech-to-text providers. STT_PROVIDER is the safe default; the available
## list controls which signed per-session choices this worker accepts.
## whisper: Speaches/faster-whisper REST (default, bundled in the RunPod image)
## qwen: Qwen3-ASR served by vLLM's OpenAI transcription API
STT_PROVIDER=whisper
STT_AVAILABLE_PROVIDERS=whisper
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_MODEL=Systran/faster-whisper-medium.en
STT_LANGUAGE=en
STT_USE_REALTIME=false
# Only required when the selected STT endpoint is protected.
STT_API_KEY=local
# Optional; derived from STT_BASE_URL as /health by default.
# STT_HEALTH_URL=http://127.0.0.1:8000/health

## To expose Qwen in the UI, deploy its private companion runtime, configure
## the provider-specific endpoint, then set:
## STT_AVAILABLE_PROVIDERS=whisper,qwen
# QWEN_ASR_BASE_URL=http://qwen-asr.internal:8011/v1
# QWEN_ASR_HEALTH_URL=http://qwen-asr.internal:8011/health
# QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# QWEN_ASR_LANGUAGE=
# QWEN_ASR_USE_REALTIME=false
# QWEN_ASR_API_KEY=replace_with_secret

## GPU services; keep local model endpoints bound to loopback on RunPod
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
LLM_DISABLE_THINKING=true
LLM_MAX_COMPLETION_TOKENS=220
# Vision model used to read shared-screen frames (Ollama VLM).
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_MODEL=qwen2.5vl:3b
VISION_TIMEOUT_SECONDS=90
VISION_PRELOAD=false
CHATTERBOX_BASE_URL=http://127.0.0.1:8004/v1
CHATTERBOX_MODEL=chatterbox-turbo
CHATTERBOX_VOICE=Olivia.wav
CHATTERBOX_TIMEOUT_SECONDS=30
CHATTERBOX_MAX_SEGMENT_CHARS=120
CHATTERBOX_RETRY_ATTEMPTS=1
